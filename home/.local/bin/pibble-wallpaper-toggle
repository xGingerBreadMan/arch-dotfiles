#!/usr/bin/env bash
CFG="$HOME/.config/quickshell/pibble-wallpaper"

if ! pgrep -f "qs -p $CFG" >/dev/null; then
    setsid -f qs -p "$CFG" >/tmp/pibble-wallpaper.log 2>&1
    for _ in {1..20}; do
        sleep 0.1
        qs -p "$CFG" ipc call wallpaper toggle >/dev/null 2>&1 && exit 0
    done
    exit 1
fi

qs -p "$CFG" ipc call wallpaper toggle
